# Copia este archivo como .env. Nunca versiones el .env real.

# Base de datos
POSTGRES_USER=bandit
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=bandit
DATABASE_URL=postgresql+asyncpg://bandit:cambia-esta-clave@db:5432/bandit

# Seguridad
# Genera CAMERA_ENCRYPTION_KEY con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_ENCRYPTION_KEY=
COOKIE_SECURE=false

# Opcional. Lo normal es crear la cuenta en /registrarse. Este administrador
# ve todos los locales y se crea al arrancar si no existe ningún usuario.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Solo para probar: crea la cuenta usuario admin, clave admin. Déjalo en false en un local real.
DEMO_ADMIN=false
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Respaldos en orden, separados por coma: si un modelo se queda sin cuota se usa el siguiente.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Opcional: modelo para tareas de texto (extraer el directorio y sugerir rutas de cámaras).
# Útil si el modelo principal se queda sin cuota. Vacío = usa GEMINI_MODEL.
GEMINI_DIRECTORY_MODEL=
GEMINI_MEDIA_RESOLUTION=high
GEMINI_MAX_CONCURRENCY=4
ANALYSIS_MIN_INTERVAL_SECONDS=10
ANALYSIS_DAILY_CALL_LIMIT=4320

# Nube de Imou (opcional): permite registrar cámaras como imou://<serie>/<canal>?stream=1
# cuando el servidor no alcanza la cámara por la red local. Credenciales en
# open.imoulife.com > My application. Usa el centro de datos de tu cuenta:
# or = América, fk = Europa, sg = Asia.
IMOU_APP_ID=
IMOU_APP_SECRET=
IMOU_API_URL=https://openapi-or.easy4ip.com/openapi

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=bandit_incidente
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v23.0

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Directorio
DIRECTORY_SCRAPE_INTERVAL_HOURS=24
# Salario mínimo legal mensual en pesos, para recompensas publicadas en SMLMV.
# Actualízalo cada año (1423500 es el de 2025).
SMLMV_COP=1423500
REVALIDATE_SECRET=
FRONTEND_INTERNAL_URL=http://frontend:3000

# Archivos compartidos entre backends (evidencia y fotos del directorio) en Supabase Storage.
# Crea un bucket PRIVADO con este nombre. Vacío = disco local de este backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bandit

# Con varios backends sobre la misma base (por ejemplo Render y un PC), solo uno captura.
CAMERA_CAPTURE_ENABLED=true

# Retención de evidencia
EVIDENCE_RETENTION_DAYS=7

# Video de las cámaras
FFMPEG_PATH=ffmpeg

# WebSockets desde otro dominio (por ejemplo el frontend en Vercel), separados por coma.
# Vacío = solo el mismo dominio del backend, como detrás de Caddy.
WS_ALLOWED_ORIGINS=

# Prueba de rostros: compara a quien aparece en cámara solo con personas de prueba que dieron
# su consentimiento (python -m bandit.tools.wanted_match agregar). Apagada por defecto.
FACE_WATCH_ENABLED=false
FACE_WATCH_MODEL=gemini-3.1-flash-lite
FACE_WATCH_DAILY_LIMIT=300

# Frontend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
