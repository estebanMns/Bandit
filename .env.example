# Copia este archivo como .env. Nunca versiones el .env real.

# Base de datos
POSTGRES_USER=bandit
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=bandit
DATABASE_URL=postgresql+asyncpg://bandit:cambia-esta-clave@db:5432/bandit

# Seguridad
# Genera SESSION_SECRET con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Genera CAMERA_ENCRYPTION_KEY con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_ENCRYPTION_KEY=
COOKIE_SECURE=false

# Primer administrador, creado al arrancar si no existe ningún usuario
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MEDIA_RESOLUTION=high
GEMINI_MAX_CONCURRENCY=4
ANALYSIS_MIN_INTERVAL_SECONDS=10
ANALYSIS_DAILY_CALL_LIMIT=4320

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=bandit_incidente
WHATSAPP_TEMPLATE_LANGUAGE=es

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Directorio
DIRECTORY_SCRAPE_INTERVAL_HOURS=24
REVALIDATE_SECRET=
FRONTEND_INTERNAL_URL=http://frontend:3000

# Retención de evidencia
EVIDENCE_RETENTION_DAYS=7

# Frontend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
