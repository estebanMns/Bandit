[importlinter]
root_package = bandit

# El análisis de video y el directorio nunca se conocen entre sí.
[importlinter:contract:video-directorio-aislados]
name = Analisis y directorio estan aislados
type = forbidden
source_modules =
    bandit.analysis
    bandit.cameras
    bandit.incidents
forbidden_modules =
    bandit.directory
    bandit.faces

[importlinter:contract:directorio-sin-video]
name = El directorio no conoce el video
type = forbidden
source_modules =
    bandit.directory
forbidden_modules =
    bandit.analysis
    bandit.cameras
    bandit.incidents
    bandit.faces

# La prueba de rostros no conoce el directorio ni los incidentes: bootstrap los conecta.
[importlinter:contract:rostros-aislados]
name = La prueba de rostros no conoce el directorio ni los incidentes
type = forbidden
source_modules =
    bandit.faces
forbidden_modules =
    bandit.directory
    bandit.incidents
    bandit.analysis

# Dentro de cada módulo, el dominio no depende de capas externas.
[importlinter:contract:capas]
name = Las capas internas no dependen de las externas
type = layers
containers =
    bandit.identity
    bandit.establishments
    bandit.cameras
    bandit.analysis
    bandit.incidents
    bandit.directory
    bandit.notifications
    bandit.realtime
    bandit.places
    bandit.faces
layers =
    (api)
    (infrastructure)
    (application)
    (domain)
exhaustive = false

# Los lugares solo usan OpenStreetMap: no conocen el video ni a las personas del directorio.
[importlinter:contract:lugares-aislados]
name = Los lugares no conocen el video ni el directorio
type = forbidden
source_modules =
    bandit.places
forbidden_modules =
    bandit.analysis
    bandit.cameras
    bandit.incidents
    bandit.directory
